{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=YOUR_SERVER;Initial Catalog=InventoryManagement;User ID=YOUR_USER;Password=YOUR_PASSWORD"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_YOUR_SECRET_KEY_MIN_32_CHARS_LONG",
    "Issuer": "InventoryManagementSystem",
    "Audience": "InventoryManagementSystemClient",
    "ExpiryMinutes": 10,
    "RefreshTokenExpiryDays": 15
  },
  "AllowedHosts": "*"
}
